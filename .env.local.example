# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.

# MongoDB Atlas connection string (free tier cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/luxvio?retryWrites=true&w=majority

# Cloudinary (free tier) — used for admin-uploaded package photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Long random secret used to sign admin session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
